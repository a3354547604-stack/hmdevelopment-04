# server/ 环境变量样例。复制为 server/.env 后按需修改；.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 所有值都有 dev 兜底（docker compose up 可零配置启动），但 APP_ENV=prod 时占位符密钥会让服务拒绝启动。

# ---- 运行环境 ----
APP_ENV=dev                     # dev | prod
LOG_LEVEL=INFO
SERVER_VERSION=1.0.0
# 时钟口径：CAL-09 未完成前必须保持 server（节点 ts = 自开机毫秒数，服务器按收到时刻纠正）
CLOCK_SOURCE=server             # server | device

# ---- MySQL 8 ----
DB_HOST=db                      # 容器内用 db；宿主机直连用 127.0.0.1
DB_PORT=3306
DB_NAME=eldercare
DB_USER=eldercare
DB_PASSWORD=hmprogram-dev-pass
MYSQL_ROOT_PASSWORD=hmprogram-dev-root   # 仅 dev 用；生产必须改
DB_AUTO_MIGRATE=1               # 启动时按 db/schema.sql 幂等建表（DDL 见契约 §7.13）
DB_PORT_HOST=3306               # 绑定到宿主机 127.0.0.1 的端口
API_PORT=3000                   # 绑定到宿主机 127.0.0.1 的后端端口（契约 §0.8：Nginx → 127.0.0.1:3000）
HTTP_PORT=8080                  # 可选 nginx 反代（profile=proxy）绑定端口

# ---- 鉴权（生产必须替换；不得提交真实值）----
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_DAYS=7
WEBHOOK_TOKEN=dev-webhook-token-change-me

# ---- IoTDA 应用侧（§4.1/§4.2；CAL-07 的值由 PM 分配，不进仓库）----
IOTDA_DISPATCH_MODE=mock        # mock（离线演示/测试）| real（真实调用华为云 IoTDA）
IOTDA_ENDPOINT=https://iotda.cn-north-4.myhuaweicloud.com
IOTDA_PROJECT_ID=
IOTDA_APP_ID=
IOTDA_APP_SECRET=
IOTDA_IAM_USER=
IOTDA_IAM_PASSWORD=
IOTDA_IAM_DOMAIN=

# ---- 推送（Push Kit，P1；mock 只记日志与推送计数）----
PUSH_MODE=mock                  # mock | real
PUSH_CLIENT_ID=
PUSH_CLIENT_SECRET=

# ---- 调度器 ----
SCHEDULER_ENABLED=1             # 重推/离线/报表归并的后台线程；测试置 0

# ---- CORS（契约 §6.1：仅放通本地调试来源）----
CORS_ORIGINS=http://localhost,http://127.0.0.1
