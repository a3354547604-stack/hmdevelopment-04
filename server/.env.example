# server/ 环境变量样例。复制为 server/.env 后按需修改；.env 已被 .gitignore 忽略，**禁止提交真实密钥**。
# 开发：所有值都有 dev 兜底，`docker compose up` 可零配置启动。
# 生产：用 docker-compose.prod.yml；`APP_ENV=prod` 时若 JWT_SECRET/WEBHOOK_TOKEN 仍是占位符，进程**拒绝启动**。
#
# ── 部署机必填 5 项（其余可留默认）──────────────────────────────────────────────
#   1) MYSQL_ROOT_PASSWORD / DB_PASSWORD  随机强口令（别用这里的 dev 值）
#   2) JWT_SECRET                         随机 32 字节以上（泄露=可伪造任意用户 token）
#   3) WEBHOOK_TOKEN                      随机 32 字节 hex（IoTDA 转发 URL 的 ?token=）
#   4) PUBLIC_HTTP_PORT                   对外端口（默认 80；被占用就改 8080 并在云安全组放通）
# 生成随机值：openssl rand -hex 32

# ---- 运行环境 ----
APP_ENV=dev                     # dev | prod（生产 compose 默认就是 prod）
LOG_LEVEL=INFO
SERVER_VERSION=1.0.0
# 时钟口径：CAL-09 未完成前必须保持 server（节点 ts = 自开机毫秒数，服务器按收到时刻纠正）
CLOCK_SOURCE=server             # server | device

# ---- MySQL 8 ----
DB_HOST=db                      # 容器内用 db；宿主机直连用 127.0.0.1
DB_PORT=3306
DB_NAME=eldercare
DB_USER=eldercare
DB_PASSWORD=hmprogram-dev-pass           # 生产必改
MYSQL_ROOT_PASSWORD=hmprogram-dev-root   # 仅 dev 用；生产必改
DB_AUTO_MIGRATE=1               # 启动时按 db/schema.sql 幂等建表（DDL 见契约 §7.13）
DB_PORT_HOST=3306               # 仅开发 compose：3306 绑到宿主机 127.0.0.1（生产 compose 不发布该端口）
API_PORT=3000                   # 绑到宿主机 127.0.0.1 的后端端口（契约 §0.8：Nginx → 127.0.0.1:3000）
PUBLIC_HTTP_PORT=80             # 仅生产 compose：nginx 对外端口（IoTDA 回调入口，需在云安全组放通）
HTTP_PORT=8080                  # 仅开发 compose：可选 nginx 反代（profile=proxy）绑到 127.0.0.1 的端口

# ---- 备份 ----
BACKUP_KEEP=14                  # server/tools/db-backup.sh 保留最近几份；输出目录由参数指定（默认 server/backups/）

# ---- 鉴权（生产必须替换；不得提交真实值）----
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_DAYS=7
WEBHOOK_TOKEN=dev-webhook-token-change-me

# ---- IoTDA 应用侧（§4.1/§4.2；CAL-07 的值由 PM 分配，不进仓库）----
IOTDA_DISPATCH_MODE=mock        # mock（离线演示/测试）| real（真实调用华为云 IoTDA）
IOTDA_ENDPOINT=https://iotda.cn-north-4.myhuaweicloud.com
IOTDA_PROJECT_ID=
IOTDA_APP_ID=
IOTDA_APP_SECRET=
IOTDA_IAM_USER=
IOTDA_IAM_PASSWORD=
IOTDA_IAM_DOMAIN=

# ---- 推送（Push Kit，P1；mock 只记日志与推送计数）----
PUSH_MODE=mock                  # mock | real
PUSH_CLIENT_ID=
PUSH_CLIENT_SECRET=

# ---- 调度器 ----
SCHEDULER_ENABLED=1             # 重推/离线/报表归并的后台线程；测试置 0

# ---- CORS（契约 §6.1：仅放通本地调试来源）----
CORS_ORIGINS=http://localhost,http://127.0.0.1
