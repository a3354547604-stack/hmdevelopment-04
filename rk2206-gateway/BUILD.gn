# RK2206 网关组件构建脚本（OpenHarmony 3.0 LTS / LiteOS-M，hb build 体系）
#
# 为什么长这样：
#   1. GN 要求目标必须在**源码树内**，而本仓库（HMProgram/rk2206-gateway）不在 SDK 树里，
#      所以 tools/gw-build.sh 会在构建前把 src/* 暂存到
#      <SDK>/vendor/lockzhiner/rk2206/samples/t4_gateway/，构建后立刻还原 vendor 树。
#      → include_dirs 里的 "//vendor/lockzhiner/rk2206/samples/t4_gateway" 就是那个暂存目录。
#   2. include_dirs 逐条来自官方样例 d8_iot_cloud_TH（IoTDA 联网）与 b16_iot_pwm（PWM）
#      与 b7_wifi_tcp（lwip/socket）：paho、cJSON、lwip、iot_pwm、board 各有各的路径，
#      少一条就会以 "No such file or directory: MQTTClient.h / cJSON.h / iot_pwm.h" 收场。
#   3. deps 只留 hardware:hardware：paho 与 cJSON 已经由
#      //device/rockchip/rk2206/sdk_liteos/BUILD.gn 全局链进镜像（libpahomqtt_static.a /
#      libcjson_static.a），这里再 deps 一次也不会更强，反而容易与 SDK 内部版本撞车。

import("//build/lite/config/component/lite_component.gni")

static_library("gateway_app") {
    sources = [
        "gw_main.c",        # 入口 + 任务编排 + 汇聚帧分派（契约 §3.8）
        "gw_proto.c",       # 帧编解码 + CRC16/MODBUS + 分帧容错（§3）
        "gw_rules.c",       # 燃气/跌倒/无活动/离线/去重状态机（§8）
        "gw_iotda.c",       # 属性/事件/明细/命令响应报文（§4.3–§4.6）
        "gw_cloud.c",       # paho MQTT：一机一密鉴权、QoS1、keepalive 120（§4.1）
        "gw_cache.c",       # 断网缓存 2000 条（§4.7）
        "gw_timesync.c",    # 联网后取 UTC（HTTP /api/time → NTP），取不到就不连云
        "gw_crypto.c",      # SHA-256 / HMAC-SHA256（Password 计算）
        "gw_time.c",        # UTC 格式化、event_id、时间外推
        "gw_alarm.c",       # 声光与静音（§8.1/§4.5/§4.7）
        "gw_433.c",         # 433 求助输入：中断 + 200 ms 复查 + 3 s 去重
        "gw_plat.c",        # 引脚/外设适配（UART0、GPIO、PWM、Flash）
        "gw_prov.c",        # 配网状态机 + 本地 API 逻辑（§12，纯逻辑可主机单测）
        "gw_prov_route.c",  # HTTP 路由：5 个接口 + 内嵌 H5 页面（§12.11）
        "gw_http.c",        # 最小 HTTP/1.1 服务端（单任务串行，socket 走 lwip/主机桩）
        "gw_net.c",         # 板级 Wi-Fi：SoftAP / STA / 2.4 G 预检（wifi_lite）
        "gw_store.c",       # 配网持久化：Wi-Fi 凭证 + 绑定白名单（Vendor Flash）
        "gw_kvcfg.c",       # 设备凭证 KV：编解码 + 写入/读回校验 + 串口命令本体（纯逻辑）
        "gw_wifi_shell.c",  # 串口 `wifi show/set/scan` 命令本体（纯逻辑，回调表注入）
        "gw_kvcfg_shell.c", # 把 `gwkv` / `wifi` 挂到 SDK 自带 shell（板级，主机自测不编）
    ]

    include_dirs = [
        "//vendor/lockzhiner/rk2206/samples/t4_gateway",
        "//utils/native/lite/include",
        "//device/rockchip/rk2206/adapter/include",
        "//device/rockchip/rk2206/adapter/include/lz_hardware/",
        "//device/rockchip/rk2206/sdk_liteos/board/include",
        "//kernel/liteos_m/kernel/include",
        "//base/iot_hardware/peripheral/interfaces/kits",
        "//third_party/cJSON",
        "//third_party/musl/porting/liteos_m/kernel/include",
        "//third_party/paho_mqtt/MQTTPacket/src",
        "//third_party/paho_mqtt/MQTTClient-C/src",
        "//third_party/lwip/src/include/lwip",
        # 串口 shell（osCmdReg / CMD_TYPE_STD）：这条**不是** board_include_dirs 里已有的路径
        # （已核对 sdk_liteos/config.gni），所以补它不会造成 CAL-13 那种重复 -I 改命中顺序的问题。
        "//kernel/liteos_m/components/shell/include",
        # ⚠ 不要在这里补 //third_party/lwip/src/include 或 wifiservice 等路径：
        #   sdk_liteos/config.gni 的 board_include_dirs 已经全局带了它们，而 GN 会把我这份
        #   排在 board 那份**前面**。重复的 -I 不只是冗余，它会改变头文件命中顺序：
        #   实测加上 //third_party/lwip/src/include 后，gw_timesync.c 的 lwip/sockets.h
        #   从 porting 版（musl 友好）变成 lwip 原版 → 拉进 arch/cc.h → 与 musl 头冲突，
        #   整个 hb build 在 [845/867] 挂掉（见技术笔记 CAL-13）。
    ]

    deps = [
        "//device/rockchip/hardware:hardware",
    ]
}
