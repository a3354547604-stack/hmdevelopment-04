/**
 * hvigor 运行时配置。
 *
 * ⚠️ 位置敏感：必须在 `<工程>/hvigor/hvigor-config.json5`；放工程根目录不生效，
 *    会报 `Hvigor config file .../hvigor/hvigor-config.json5 does not exist.`
 *
 * ⚠️ 依赖指向**本地命令行工具链**（file: 绝对路径）而不是 npm 源：
 *    本机 npm 源慢且易失败，且拉公网插件会污染锁文件。
 *    这两行是本工程唯一的机器相关配置，换机器需同步改（构建方法见 README.md）。
 */
{
  "modelVersion": "5.0.0",
  "dependencies": {
    "@ohos/hvigor-ohos-plugin": "file:/home/qinyixiang/harmony-toolchain/clt/command-line-tools/hvigor/hvigor-ohos-plugin",
    "@ohos/hvigor": "file:/home/qinyixiang/harmony-toolchain/clt/command-line-tools/hvigor/hvigor"
  },
  "execution": {},
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 8192
  }
}
