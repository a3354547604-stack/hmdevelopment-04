<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!--
      Android 13(API 33) 起，纯配网 App 应改用 NEARBY_WIFI_DEVICES 并声明 neverForLocation；
      12 及以下仍然必须给 ACCESS_FINE_LOCATION，否则 WifiManager.getScanResults() 返回空表
      （契约 §13.2 第 3 步已写明这个坑）。两个权限都声明，运行时按 SDK 版本二选一申请。
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 用 WifiNetworkSpecifier 连设备热点（API 29+）必须显式声明，否则运行时报 SecurityException -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="true" />

    <application
        android:name=".ProvisionApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElderCare.Provision"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.ProvisionActivity"
            android:exported="false"
            android:label="@string/title_provision"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.WifiScanActivity"
            android:exported="false"
            android:label="@string/title_wifi_scan"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.PairNodesActivity"
            android:exported="false"
            android:label="@string/title_pair_nodes"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.DevSettingsActivity"
            android:exported="false"
            android:label="@string/title_dev_settings"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name="ui.DevicesActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="ui.AlertListActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="ui.AlertDetailActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="ui.ReportsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="ui.SettingsActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name="ui.SmokeActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
