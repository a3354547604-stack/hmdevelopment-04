<?xml version="1.0" encoding="utf-8"?>
<!--
  为什么全局放开明文 HTTP

  本 App 要访问两类明文地址，而它们的 host 在打包时都不可知：
    ① 小盒子热点里的本地服务（契约 §12.1，明文是设备侧的有意取舍）
    ② 自建的云端服务（契约 §6.1，现场局域网内以明文提供服务）
  ② 的地址每次现场都不一样，App 内可改（高级设置），所以无法预先枚举域。
  Android 9+ 默认禁明文，用 <domain> 白名单会出现「在家能用、到现场改了地址就连不上」的
  随机故障——演示最怕这种问题，因此这里选择全局放开，并在运行期用「地址必须由用户显式填写
  且带协议前缀」来兜住风险。
  上生产（或改用证书）时应把本文件恢复成只放行小盒子热点的 domain-config。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
