<?xml version="1.0" encoding="utf-8"?>
<!--
  提醒详情：与鸿蒙 AlertDetailPage.ets 一比一。
  结构 = 返回条 + 可滚内容（标题/状态/时间 + 备注 + 处理记录）+ 钉在屏底的处置栏。
  底栏钉死是刻意的：老人不会往下滚，按钮必须永远在视线里。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/level1_deep"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="8dp"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/font_caption"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:text="@string/back_label"
        android:textColor="@color/color_primary"
        android:textSize="@dimen/font_body" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/page_padding">

            <!-- 头卡：一句人话 + 状态 + 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/font_caption" />

                <TextView
                    android:id="@+id/tvSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/font_body" />
            </LinearLayout>

            <!-- 备注：只在还没处理时出现 -->
            <LinearLayout
                android:id="@+id/cardNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_input"
                    android:hint="@string/alert_note_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="200"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/font_body" />
            </LinearLayout>

            <!-- 处理记录 -->
            <LinearLayout
                android:id="@+id/cardHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_history_title"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/font_label" />

                <LinearLayout
                    android:id="@+id/listHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底栏：白底 + 顶部 1dp 分隔线，永远可见 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="10dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/level2_text"
            android:textSize="@dimen/font_caption"
            android:visibility="gone" />

        <!-- 已处理后的四个原因 -->
        <LinearLayout
            android:id="@+id/containerReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/alert_reason_pick"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/font_body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReasonContact"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:text="@string/alert_reason_contact"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/font_body"
                    app:cornerRadius="@dimen/btn_radius"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReasonVisit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:text="@string/alert_reason_visit"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/font_body"
                    app:cornerRadius="@dimen/btn_radius"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReasonFalse"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:text="@string/alert_reason_false"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/font_body"
                    app:cornerRadius="@dimen/btn_radius"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReasonOther"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_weight="1"
                    android:text="@string/alert_reason_other"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/font_body"
                    app:cornerRadius="@dimen/btn_radius"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelReason"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="10dp"
                android:text="@string/action_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_body"
                app:cornerRadius="@dimen/btn_radius"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAck"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_weight="1"
                android:text="@string/alert_btn_know"
                android:textAllCaps="false"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/font_body"
                app:cornerRadius="@dimen/btn_radius"
                app:strokeColor="@color/color_primary"
                app:strokeWidth="1dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="@dimen/btn_height"
                android:layout_weight="1"
                android:backgroundTint="@color/color_primary_fill"
                android:text="@string/alert_handled"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/font_body"
                app:cornerRadius="@dimen/btn_radius" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
