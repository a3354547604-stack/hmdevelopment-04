<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView android:id="@+id/tvGatewayHint" style="@style/CardBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pair_gateway_hint" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnScan" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/action_pair_scan" />
        <Button android:id="@+id/btnRefresh" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/action_refresh_list" />
    </LinearLayout>

    <TextView android:id="@+id/tvScanState" style="@style/CardBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/listNodes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>

    <TextView style="@style/CardTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/label_bound_list" />
    <LinearLayout android:id="@+id/listBound" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" />

    <Button android:id="@+id/btnDone" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/action_back_to_provision" />
</LinearLayout>
