<?xml version="1.0" encoding="utf-8"?>
<!-- 设置（F11）：21 键阈值 + 静音 + 上报周期 + 演示事件 + 退出登录；Mock 开关入口（F12） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOfflineBanner"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/err_bg"
            android:padding="8dp"
            android:text="@string/offline_banner"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAccount"
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSource"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_thresholds" />

        <LinearLayout
            android:id="@+id/listSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSaveAll"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save_all" />

        <Button
            android:id="@+id/btnDispatch"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_dispatch_settings" />

        <TextView
            android:id="@+id/tvDispatchResult"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_mute" />

        <TextView
            android:id="@+id/tvMuteState"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMute30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_mute_30" />

            <Button
                android:id="@+id/btnMute60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_mute_60" />

            <Button
                android:id="@+id/btnUnmute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_unmute" />
        </LinearLayout>

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_demo" />

        <TextView
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/demo_note" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDemoGas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_demo_gas" />

            <Button
                android:id="@+id/btnDemoFall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_demo_fall" />

            <Button
                android:id="@+id/btnDemoSos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_demo_sos" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDemoResult"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_mock" />

        <CheckBox
            android:id="@+id/cbMock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_mock" />

        <TextView
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_mock_note" />

        <Button
            android:id="@+id/btnSmoke"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_smoke_test" />

        <Button
            android:id="@+id/btnDevSettings"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_dev_settings" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_logout" />
    </LinearLayout>
</ScrollView>
