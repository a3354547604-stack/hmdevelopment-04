<?xml version="1.0" encoding="utf-8"?>
<!-- 维护设置：只在「我的 → 连点版本号 5 次 → 高级」里进入，普通用户看不到 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner"
            android:padding="8dp"
            android:text="@string/offline_banner"
            android:textColor="@color/warn"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_maintenance"
            android:textColor="@color/brand_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/value_unknown"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/listSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnSaveAll"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand"
            android:text="@string/action_save_all"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnDispatch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_alt"
            android:text="@string/action_dispatch_settings"
            android:textColor="@color/brand_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDispatchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_mute"
            android:textColor="@color/brand_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMuteState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/msg_not_muted"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMute30"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/action_mute_30"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnMute60"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/action_mute_60"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnUnmute"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/action_unmute"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_cloud"
            android:textColor="@color/brand_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIotdaHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cloud_host"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etIotdaPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cloud_port"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etIotdaDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cloud_device"
            android:importantForAutofill="no"
            android:inputType="text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etIotdaSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_cloud_secret"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSubmitIotda"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand"
            android:text="@string/action_submit_cloud"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvIotdaState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/msg_cloud_none"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSelfCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/brand"
            android:text="@string/action_self_check"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/muted"
            android:text="@string/action_close"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
