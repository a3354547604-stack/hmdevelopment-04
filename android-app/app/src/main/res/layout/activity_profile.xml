<?xml version="1.0" encoding="utf-8"?>
<!--
  「我的」页 —— 逐段照搬 harmony-app/entry/src/main/ets/pages/ProfilePage.ets：
  五段「13sp 小节标题 + 白卡」：家人 / 设备 / 手机提醒 / 账号 / 关于。
  尺寸口径：1dp = 1vp（与鸿蒙预览器 360vp 同坐标系），字号 sp 对应 fp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/level1_deep"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="8dp"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/font_caption"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <!-- ============ 家人 ============ -->
            <TextView
                style="@style/SectionLabel"
                android:text="@string/sec_family" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track"
                        android:contentDescription="@null"
                    android:src="@drawable/ic_family"
                    app:tint="@color/color_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/family_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 设备 ============ -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="12dp"
                android:text="@string/sec_device" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddDevice"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:text="@string/bind_device"
                    android:textAllCaps="false"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/font_body"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="@dimen/btn_radius"
                    app:elevation="0dp"
                    app:strokeColor="@color/color_primary"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- ============ 手机提醒 ============ -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="12dp"
                android:text="@string/sec_notify" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notify_hint"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/notify_hint_sub"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/font_caption" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swNotify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track"
                        android:contentDescription="@string/notify_hint" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notify_dnd"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/notify_dnd_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/font_caption" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swDnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track"
                        android:contentDescription="@string/notify_dnd" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notify_urgent"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/notify_urgent_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/font_caption" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swUrgent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track"
                        android:contentDescription="@string/notify_urgent" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 账号 ============ -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="12dp"
                android:text="@string/sec_security" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_phone"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />

                    <TextView
                        android:id="@+id/tvAccountValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <LinearLayout
                    android:id="@+id/rowChangePwd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/change_pwd"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />

                    <TextView style="@style/Chevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <LinearLayout
                    android:id="@+id/rowLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_logout"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSavedTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/saved_tip"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/font_caption"
                android:visibility="gone" />

            <!-- ============ 关于 ============ -->
            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="12dp"
                android:text="@string/sec_about" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding">

                <LinearLayout
                    android:id="@+id/rowHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_help"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />

                    <TextView style="@style/Chevron" />
                </LinearLayout>

                <View style="@style/RowDivider" />

                <LinearLayout
                    android:id="@+id/rowVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/version_label"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
