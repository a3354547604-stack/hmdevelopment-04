<?xml version="1.0" encoding="utf-8"?>
<!-- 告警列表（F8）：分页 + 状态/类型筛选 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvOfflineBanner"
        style="@style/CardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/err_bg"
        android:padding="8dp"
        android:text="@string/offline_banner"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/spType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTotal"
        style="@style/CardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnMore"
        style="@style/Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_load_more" />

    <Button
        android:id="@+id/btnRefresh"
        style="@style/Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_refresh_list" />
</LinearLayout>
