<?xml version="1.0" encoding="utf-8"?>
<!-- 告警详情 + 处置（F9）：处置成功后通知列表刷新 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOfflineBanner"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/err_bg"
            android:padding="8dp"
            android:text="@string/offline_banner"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAlertTitle"
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvAlertMeta"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_dispositions" />

        <LinearLayout
            android:id="@+id/listDispo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_dispose_action" />

        <EditText
            android:id="@+id/etNote"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_dispose_note"
            android:inputType="text"
            android:maxLength="200" />

        <Button
            android:id="@+id/btnContacted"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_contacted" />

        <Button
            android:id="@+id/btnChecked"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_checked" />

        <Button
            android:id="@+id/btnFalseAlarm"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_false_alarm" />

        <Button
            android:id="@+id/btnOther"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_other" />

        <TextView
            android:id="@+id/tvDisposeResult"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_readings_around" />

        <LinearLayout
            android:id="@+id/listReadings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnRefresh"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_refresh" />
    </LinearLayout>
</ScrollView>
