<?xml version="1.0" encoding="utf-8"?>
<!-- 首页（F7）：14 个属性 + 节点列表 + 在线状态；下拉刷新 + 10 s 轮询 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvMockBanner"
        style="@style/CardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warn_bg"
        android:padding="8dp"
        android:text="@string/mock_banner"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvOfflineBanner"
        style="@style/CardBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/err_bg"
        android:padding="8dp"
        android:text="@string/offline_banner"
        android:visibility="gone" />

    <com.hmprogram.eldercare.provision.ui.PullToRefreshLayout
        android:id="@+id/ptr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvPull"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/pull_hint"
            android:textColor="@color/brand"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvAccount"
                    style="@style/CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_no_account" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    style="@style/CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_no_device" />

                <TextView
                    android:id="@+id/tvOnline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/status_unknown"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvAlertsHint"
                    style="@style/CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/report_no_data" />

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_properties" />

                <LinearLayout
                    android:id="@+id/listProps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_nodes" />

                <LinearLayout
                    android:id="@+id/listNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnAlerts"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_open_alerts" />

                <Button
                    android:id="@+id/btnReport"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_open_report" />

                <Button
                    android:id="@+id/btnSettings"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_open_settings" />

                <Button
                    android:id="@+id/btnDevices"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_open_devices" />

                <Button
                    android:id="@+id/btnAddDevice"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_add_device" />

                <Button
                    android:id="@+id/btnScanQr"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_scan_qr" />

                <Button
                    android:id="@+id/btnDevSettings"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_dev_settings" />

                <Button
                    android:id="@+id/btnLogout"
                    style="@style/Field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_logout" />
            </LinearLayout>
        </ScrollView>
    </com.hmprogram.eldercare.provision.ui.PullToRefreshLayout>
</LinearLayout>
