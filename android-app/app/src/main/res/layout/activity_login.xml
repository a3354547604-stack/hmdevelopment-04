<?xml version="1.0" encoding="utf-8"?>
<!--
  登录页布局：与鸿蒙版 pages/LoginPage.ets 的 build() 逐项对应（结构、间距、字号同源）。
    鸿蒙 Column(space 6).margin(top 88, bottom 40)   -> 标题块
    鸿蒙 Column(space 12).padding(16).radius(12) 白卡 -> 表单卡
      · 标签 14fp 次级色 + 输入框 48vp 浅灰底圆角 8
      · 密码行 = 输入框(weight 1) + 「显示/隐藏」14fp 主色文字
      · 错误提示 14fp 级别二文字色（红字常显，不弹 toast）
      · 主按钮 48vp、圆角 8、主色填充
      · 「还没有账号？立即注册」是一行 14fp 主色文字（不是按钮）
    鸿蒙 footer margin(top 28) -> 「装上它，爸妈在家有个照应」14fp 提示色
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:layout_marginBottom="24dp"
            android:text="@string/app_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tvExpiredHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_expired"
                android:textColor="@color/level1_text"
                android:textSize="@dimen/font_caption"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_phone"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_caption" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_phone_input"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLength="11"
                android:paddingStart="12dp"
                android:paddingTop="0dp"
                android:paddingEnd="12dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/font_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_password"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_height"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_password_input"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLength="64"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/font_body" />

                <TextView
                    android:id="@+id/tvShowPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:minWidth="@dimen/touch_min"
                    android:text="@string/action_show"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/font_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/level2_text"
                android:textSize="@dimen/font_caption"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:elevation="0dp"
                android:letterSpacing="0"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:stateListAnimator="@null"
                android:alpha="0.5"
                android:enabled="false"
                android:text="@string/action_login"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                android:textSize="@dimen/font_body"
                app:backgroundTint="@color/color_primary_fill"
                app:cornerRadius="@dimen/btn_radius" />

            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:minHeight="@dimen/touch_min"
                android:text="@string/action_register_entry"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/font_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMockBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner"
            android:padding="10dp"
            android:text="@string/mock_banner"
            android:textColor="@color/level1_text"
            android:textSize="@dimen/font_caption"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="28dp"
            android:text="@string/login_footer"
            android:textColor="@color/text_hint"
            android:textSize="@dimen/font_caption" />
    </LinearLayout>
</ScrollView>
