<?xml version="1.0" encoding="utf-8"?>
<!--
  添加节点：与鸿蒙 pages/AddNodePage.ets 对齐。
  只走网关本机接口（/pair/scan、/pair/nodes、/pair/bind），前提是手机连着主机热点；
  地址由首页「＋」格带过来，不再让用户选第二遍。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvBack"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:text="@string/back_label"
        android:textColor="@color/color_primary"
        android:textSize="@dimen/font_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="16dp"
        android:text="@string/title_add_node"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_title"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/add_node_scanning"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_caption" />

            <LinearLayout
                android:id="@+id/containerNodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnRescan"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="@string/action_rescan"
                android:textColor="@color/on_accent"
                android:textSize="@dimen/font_body"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
