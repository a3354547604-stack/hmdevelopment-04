<?xml version="1.0" encoding="utf-8"?>
<!--
  首页：与鸿蒙 pages/HomePage.ets 的 build() 一一对应。
  结构顺序（改了顺序就等于改了产品）：
    顶栏「云擎守护 + ● 在线」→ 大字卡（彩底白字 + 状态图标）→ 地址卡（家/老家，
    田字格小框 + 虚线加号格）→ 最近一条提醒 → 今天的小结 → 看看这周 → 底部三页签。
  这里没有「主机/小盒子」卡：鸿蒙版已把它删掉，设备规模与心跳由地址卡右侧的
  「N 个节点 · M 个在线」承担，多一张卡只会把结论挤下去。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/level1_deep"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="8dp"
        android:text="@string/offline_banner"
        android:textColor="@color/color_on_primary"
        android:textSize="@dimen/font_caption"
        android:visibility="gone" />

    <!-- 顶部条固定不滚：滚动时「App 连没连上」不该跟着跑掉 -->
    <com.hmprogram.eldercare.provision.ui.PullToRefreshLayout
        android:id="@+id/ptr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_padding"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/page_padding"
                android:paddingBottom="16dp">

                <!-- 大字卡：底色是级别「深色」变体，白字才够对比度 -->
                <LinearLayout
                    android:id="@+id/cardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_headline"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivStatusIcon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_status_sun"
                            app:tint="@color/on_accent" />

                        <TextView
                            android:id="@+id/tvStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:textColor="@color/on_accent"
                            android:textSize="21sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/on_accent_subtle"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>

                <!-- 网络/主机异常的一句话提示：正常时整条不占空间 -->
                <TextView
                    android:id="@+id/tvTrouble"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="4dp"
                    android:textColor="@color/level1_text"
                    android:textSize="@dimen/font_caption"
                    android:visibility="gone" />

                <!-- 地址卡：一个地址一张卡，卡内是田字格小框（运行时生成） -->
                <LinearLayout
                    android:id="@+id/containerSites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <!-- 最近一条未处理提醒 -->
                <LinearLayout
                    android:id="@+id/cardLatest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tab_alert"
                            app:tint="@color/level2" />

                        <TextView
                            android:id="@+id/tvLatestTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/font_body" />

                        <TextView
                            style="@style/Chevron"
                            android:text="›" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLatestMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_caption" />
                </LinearLayout>

                <!-- 今天的小结 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_today_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/font_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatWalk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_number_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_walk"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_label" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatAlerts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_number_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_alerts"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_label" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStatIdle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/font_number_md"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_idle"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/font_label" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 看看这周：整行可点的链接行 -->
                <LinearLayout
                    android:id="@+id/rowWeek"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginTop="@dimen/card_gap"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_week_link"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/font_body" />

                    <TextView
                        style="@style/Chevron"
                        android:text="›" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:gravity="center"
                    android:text="@string/empty_no_device"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/font_caption"
                    android:visibility="gone" />

                <!-- 网络不好时页面底部再补一句（鸿蒙 HomePage 的 HOME_NET_WEAK） -->
                <TextView
                    android:id="@+id/tvNetWeak"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/home_net_weak"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/font_caption"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </com.hmprogram.eldercare.provision.ui.PullToRefreshLayout>

    <include
        android:id="@+id/viewEmpty"
        layout="@layout/view_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
