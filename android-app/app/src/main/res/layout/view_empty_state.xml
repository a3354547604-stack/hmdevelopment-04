<?xml version="1.0" encoding="utf-8"?>
<!--
  空态：还没有添加设备（对齐鸿蒙 components/StateViews.ets 的 EmptyView）。
  为什么不是「一句话 + 让用户自己去找」：原文案写着「点下面的『绑定新设备』」，
  但页面上根本没有这个按钮——空态必须自己给出下一步，否则用户只能干看着。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_empty_folder"
        app:tint="@color/text_hint" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/empty_no_device"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/font_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/empty_no_device_hint"
        android:textColor="@color/text_hint"
        android:textSize="@dimen/font_caption" />

    <Button
        android:id="@+id/btnGoAdd"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/btn_height"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_primary_button"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/empty_go_add"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="@dimen/font_body" />
</LinearLayout>
