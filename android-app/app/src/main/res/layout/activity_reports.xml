<?xml version="1.0" encoding="utf-8"?>
<!-- 周报/月报（F10）：compare.title 必现；无昨日基线只显示 title/today，不报错 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvOfflineBanner"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/err_bg"
            android:padding="8dp"
            android:text="@string/offline_banner"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_period_week" />

            <Button
                android:id="@+id/btnMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_period_month" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCompareTitle"
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_compare" />

        <TextView
            android:id="@+id/tvCompareNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_dark"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCompareRowToday"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvCompareRowYesterday"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvCompareRowDelta"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvCompareHint"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/warn"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSummaryTitle"
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_summary" />

        <TextView
            android:id="@+id/tvSummaryActivity"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSummaryAlerts"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSummaryEnv"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvActivityTitle"
            style="@style/CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_activity_series" />

        <TextView
            android:id="@+id/tvActivity"
            style="@style/MonoLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRefresh"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_refresh" />
    </LinearLayout>
</ScrollView>
