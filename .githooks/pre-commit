#!/usr/bin/env bash
# pre-commit：对「结论类文档」跑引用门禁（docs/协议、docs/评审与验证 与显式标注的文件）
# 其它文件只提示不拦截；严格模式：CHECK_CITATIONS_STRICT=1 git commit ...
set -uo pipefail
files=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
[ -z "$files" ] && exit 0
strict=0; [ "${CHECK_CITATIONS_STRICT:-0}" = "1" ] && strict=1
block=""; warn=""
for f in $files; do
  [ -f "$f" ] || continue
  out=$(bash tools/check-citations.sh "$f" 2>&1) || {
    case "$f" in
      docs/协议/*|docs/评审与验证/*) block="$block$out\n" ;;
      *) warn="$warn$out\n" ;;
    esac
  }
done
if [ -n "$warn" ]; then printf '[pre-commit] 提示（不拦）：\n%b' "$warn"; fi
if [ -n "$block" ] || { [ "$strict" = 1 ] && [ -n "$warn" ]; }; then
  printf '[pre-commit] 引用门禁未过，已阻止提交：\n%b' "${block}${warn}"
  printf '修法见 docs/协议/文档优先协议.md；临时跳过：git commit --no-verify\n'
  exit 1
fi
exit 0
